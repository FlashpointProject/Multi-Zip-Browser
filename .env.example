# Copy to .env for local runs (or set these as environment variables).
PORT=3000
MONGO_URL=mongodb://localhost:27017/
MONGO_DB=ziparchive
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
# JSON array of directories holding .zip archives to index at start
DIRECTORIES=["/data/zips"]
# Optional
FPFSS_URL=
SERVER_PREFIX=
FORCE_REINDEX=false
